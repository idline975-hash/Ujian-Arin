          "Bahasa Arab (MI)": ["Perkenalan (At-Ta'aruf)", "Peralatan Sekolah (Al-Adawat Al-Madrasiyyah)", "Anggota Tubuh (A'da'ul Jismi)", "Warna & Angka (Al-Alwan wal A'dad)"],

          // --- PELAJARAN UMUM ---
          "Pendidikan Pancasila / PKN": ["Simbol dan Sila Pancasila", "Hak dan Kewajiban", "Keragaman Budaya", "Aturan di Rumah & Sekolah"],
          "Matematika": ["Penjumlahan & Pengurangan", "Perkalian & Pembagian", "Pecahan Sederhana", "Bangun Datar & Ruang", "Pengukuran Waktu & Panjang"],
          "IPAS (IPA-IPS)": ["Tumbuhan & Hewan di Sekitar", "Wujud Zat & Perubahannya", "Panca Indera", "Peta & Kenampakan Alam"],
          "Bahasa Indonesia": ["Membaca Nyaring & Menulis", "Puisi Anak", "Surat Pribadi", "Ide Pokok Paragraf", "Teks Deskripsi"]
        }
      },
      "SMP / MTs": {
        kelas: ["Kelas 7", "Kelas 8", "Kelas 9"],
        mapel: {
          // --- PELAJARAN KEAGAMAAN (MTs) ---
          "Akidah Akhlak (MTs)": ["Akidah Islam & Sifat-sifat Allah", "Sifat Wajib, Mustahil, & Jaiz Bagi Rasul", "Adab Kepada Orang Tua & Guru", "Akhlak Terpuji (Tawakkal, Ikhtiar, Syukur)", "Menghindari Akhlak Tercela (Ananiyah, Hasad)"],
          "Al-Qur'an Hadis (MTs)": ["Hukum Bacaan Mad & Waqaf", "Hadis tentang Menuntut Ilmu & Berbagi", "Kandungan Surah Al-Mujadilah & Ar-Rahman", "Hukum Bacaan Mim Mati & Nun Mati"],
          "Fikih (MTs)": ["Bersuci dari Hadats (Thaharah)", "Sholat Sunnah Berjamaah & Munfarid", "Sujud Sahwi, Sujud Tilawah, & Sujud Syukur", "Zakat Fitrah & Zakat Maal", "Haji dan Umrah"],
          "Sejarah Kebudayaan Islam / SKI (MTs)": ["Kondisi Masyarakat Arab Pra-Islam", "Dakwah Periode Makkah & Madinah", "Perkembangan Islam Peradaban Dinasti Umayyah", "Perkembangan Peradaban Dinasti Abbasiyah", "Peran Wali Songo di Nusantara"],
          "Bahasa Arab (MTs)": ["Fasilitas Sekolah (Al-Marafiq Al-Madrasiyyah)", "Kegiatan Sehari-hari (Al-A'mal Al-Yaumiyyah)", "Hobi (Al-Hiwayah)", "Profesi / Pekerjaan (Al-Mihnatu)"],

          // --- PELAJARAN UMUM ---
          "Matematika": ["Teorema Pythagoras", "Persamaan Kuadrat", "Sistem Persamaan Linear Dua Variabel (SPLDV)", "Statistika & Peluang", "Aritmatika Sosial"],
          "IPA (Fisika, Biologi, Kimia)": ["Sistem Pencernaan Manusia", "Hukum Newton & Gaya", "Gelombang & Bunyi", "Struktur Atom & Unsur", "Ekosistem & Lingkungan"],
          "Bahasa Indonesia": ["Teks Laporan Hasil Observasi", "Teks Eksplanasi", "Teks Puisi & Pantun", "Surat Resmi & Dinas"],
          "Bahasa Inggris": ["Simple Present Tense", "Descriptive Text", "Recount Text", "Narrative Text"],
          "IPS": ["Interaksi Antarruang", "Masa Praaksara di Indonesia", "Kegiatan Ekonomi & Pasar", "Perubahan Sosial Budaya"]
        }
      },
      "SMA / MA / SMK": {
        kelas: ["Kelas 10", "Kelas 11", "Kelas 12"],
        mapel: {
          // --- PELAJARAN KEAGAMAAN (MA) ---
          "Akidah Akhlak (MA)": ["Konsep Tauhid (Uluhiyah, Rububiyah, Asma wa Sifat)", "Tasawuf & Purifikasi Hati", "Al-Kulliyat Al-Khamsah (Perlindungan Agama, Jiwa, Akal, Keturunan, Harta)", "Etika Berbusana & Berhias dalam Islam"],
          "Al-Qur'an Hadis (MA)": ["Struktur Al-Qur'an & Sejarah Pembukuannya", "Metode Penafsiran Al-Qur'an", "Autentisitas Hadis (Sahih, Hasan, Dha'if)", "Hadis Perihal Demokrasi & Toleransi"],
          "Fikih (MA)": ["Kosep Muamalah (Jual Beli, Riba, Bank Syariah)", "Hukum Keluarga (Munakahat & Waris/Faraidh)", "Hukum Pidana Islam (Jinayah & Hudud)", "Peradilan Islam (Qadha)"],
          "Sejarah Kebudayaan Islam / SKI (MA)": ["Peradaban Islam Dinasti Utsmaniyah, Safawi, & Mughal", "Pembaharuan Pemikiran Islam (Abduh, Afghani, Khan)", "Sejarah Kerajaan-kerajaan Islam di Indonesia", "Peran Kerajaan Islam dalam Melawan Kolonialisme"],
          "Bahasa Arab (MA)": ["Teks Hiwar Keagamaan & Pendidikan", "Kaidah Nahwu (Fi'il, Fa'il, Ma'ful Bih, Idhafah)", "Kaidah Sharaf (Tashrif Lughawi & Istilahi)", "Qira'ah wa Kitabah (Membaca Teks Pendek)"],
          "Ilmu Tafsir (Keagamaan MA)": ["Sejarah Perkembangan Ilmu Tafsir", "Tafsir Bil Ma'tsur vs Bil Ra'yi", "Tafsir Tematik (Maudhu'i)", "Asbabun Nuzul"],
          "Ilmu Hadis (Keagamaan MA)": ["Unsur Hadis (Sanad, Matan, Rawi)", "Klasifikasi Hadis Berdasarkan Jumlah Rawi", "Musthalah Al-Hadith", "Kritis Sanad dan Matan"],
          "Usul Fikih (Keagamaan MA)": ["Sumber Hukum Islam (Al-Qur'an, Hadis, Ijma', Qiyas)", "Kaidah Usuliyyah (Am, Khass, Amar, Nahi)", "Ijtihad, Ittiba', & Taqlid", "Maqashid Shariah"],

          // --- PELAJARAN UMUM ---
          "Matematika Wajib / Lanjut": ["Fungsi Komposisi & Invers", "Trigonometri", "Matriks & Determinant", "Kalkulus (Limit & Turunan)", "Vektor"],
          "Fisika": ["Dinamika Gerak & Hukum Newton", "Termodinamika", "Listrik Statis & Dinamis", "Fisika Modern"],
          "Kimia": ["Struktur Atom & Tabel Periodik", "Ikatan Kimia", "Stokiometri & Reaksi Redoks", "Asam Basa & Larutan"],
          "Biologi": ["Genetika & Pewarisan Sifat", "Sistem Organ Manusia", "Bioteknologi", "Evolusi"],
          "Ekonomi / Akuntansi": ["Persamaan Dasar Akuntansi", "Jurnal Umum & Buku Besar", "Manajemen & Badan Usaha", "Pasar Modal"],
          "Bahasa Indonesia": ["Teks Negosiasi", "Teks Editorial", "Artikel Ilmiah", "Novel & Resensi"]
        }
      }
    };

    // INIT APP
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      handleJenjangChange();
    });

    // HANDLER EVENT CHANGE
    function handleJenjangChange() {
      const jenjangVal = document.getElementById("jenjang").value;
      const kelasSelect = document.getElementById("kelas");
      const mapelSelect = document.getElementById("mapel");

      // Populate Kelas
      kelasSelect.innerHTML = "";
      dataPendidikan[jenjangVal].kelas.forEach(k => {
        kelasSelect.innerHTML += `<option value="${k}">${k}</option>`;
      });

      // Populate Mapel
      mapelSelect.innerHTML = "";
      Object.keys(dataPendidikan[jenjangVal].mapel).forEach(m => {
        mapelSelect.innerHTML += `<option value="${m}">${m}</option>`;
      });

      handleMapelChange();
    }

    function handleMapelChange() {
      const jenjangVal = document.getElementById("jenjang").value;
      const mapelVal = document.getElementById("mapel").value;
      const topikSelect = document.getElementById("topikSelect");

      topikSelect.innerHTML = "";
      const daftarTopik = dataPendidikan[jenjangVal].mapel[mapelVal] || [];

      daftarTopik.forEach(t => {
        topikSelect.innerHTML += `<option value="${t}">${t}</option>`;
      });

      topikSelect.innerHTML += `<option value="Lainnya">✏️ Lainnya / Input Manual...</option>`;
      handleTopikChange();
    }

    function handleTopikChange() {
      const topikSelect = document.getElementById("topikSelect");
      const topikManual = document.getElementById("topikManual");

      if (topikSelect.value === "Lainnya") {
        topikManual.classList.remove("hidden");
        topikManual.required = true;
      } else {
        topikManual.classList.add("hidden");
        topikManual.required = false;
      }
    }

    // SIMULASI / GENERATOR SOAL VIA AI & DUMMY FALLBACK
    async function generateQuiz(e) {
      e.preventDefault();

      const btn = document.getElementById("btnSubmit");
      const jenjang = document.getElementById("jenjang").value;
      const kelas = document.getElementById("kelas").value;
      const mapel = document.getElementById("mapel").value;
      
      let topik = document.getElementById("topikSelect").value;
      if (topik === "Lainnya") {
        topik = document.getElementById("topikManual").value;
      }

      const tipeSoal = document.getElementById("tipeSoal").value;
      const jumlah = parseInt(document.getElementById("jumlahSoal").value);
      const level = document.getElementById("levelKesulitan").value;

      btn.disabled = true;
      btn.innerHTML = `<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i><span>Membuat Soal...</span>`;
      lucide.createIcons();

      // Anda dapat memasukkan Gemini API Key milik Anda di variabel ini:
      const apiKey = ""; 

      if (apiKey !== "") {
        const prompt = `Buatkan ${jumlah} soal ${tipeSoal} untuk ${jenjang} (${kelas}), mata pelajaran ${mapel}, dengan topik "${topik}".
Tingkat kesulitan: ${level}.
Sesuaikan bahasa dan konteks soal agar sesuai dengan tingkat siswa ${jenjang} (${kelas}).

Berikan respon HANYA dalam format JSON valid tanpa tanda markdown (tanpa backtick \`\`\`json):
{
  "soal": [
    {
      "nomor": 1,
      "pertanyaan": "Teks pertanyaan di sini",
      "opsi": ["A. pilihan A", "B. pilihan B", "C. pilihan C", "D. pilihan D"],
      "jawaban": "A",
      "pembahasan": "Penjelasan singkat jawaban"
    }
  ]
}`;

        try {
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
          });

          const data = await response.json();
          let rawText = data.candidates[0].content.parts[0].text;
          rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();
          const quizData = JSON.parse(rawText);

          renderQuizOutput(jenjang, kelas, mapel, topik, quizData.soal, tipeSoal, level);
        } catch (error) {
          console.error(error);
          alert("Gagal terhubung ke API AI, menampilkan template soal bawaan.");
          renderQuizFallback(jenjang, kelas, mapel, topik, tipeSoal, jumlah, level);
        } finally {
          btn.disabled = false;
          btn.innerHTML = `<i data-lucide="rocket" class="w-5 h-5"></i><span>Buat Soal</span>`;
          lucide.createIcons();
        }
      } else {
        // Fallback Simulasi Cepat (Tanpa API Key)
        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML = `<i data-lucide="rocket" class="w-5 h-5"></i><span>Buat Soal</span>`;
          lucide.createIcons();
          renderQuizFallback(jenjang, kelas, mapel, topik, tipeSoal, jumlah, level);
        }, 600);
      }
    }

    // RENDER HASIL AI
    function renderQuizOutput(jenjang, kelas, mapel, topik, daftarSoal, tipeSoal, level) {
      const container = document.getElementById("resultContainer");
      const output = document.getElementById("quizOutput");

      let html = `
        <div class="border-b-2 border-slate-800 pb-4 mb-6 text-center">
          <h2 class="text-xl font-bold uppercase tracking-wide">LEMBAR UJIAN / ASSESMEN MADRASAH & SEKOLAH</h2>
          <p class="text-sm font-semibold text-slate-600">${mapel} — ${jenjang} (${kelas})</p>
          <p class="text-xs text-slate-500 italic mt-0.5">Materi / Topik: ${topik}</p>
        </div>

        <div class="grid grid-cols-2 text-xs font-semibold gap-2 border p-3 rounded-lg bg-slate-50 mb-6">
          <div>Nama Siswa : ...........................................</div>
          <div>Tanggal : .........................</div>
          <div>Kelas/No : ...........................................</div>
          <div>Waktu : 45 Menit</div>
        </div>

        <div class="space-y-6">
      `;

      daftarSoal.forEach((item, idx) => {
        html += `
          <div class="space-y-2">
            <p class="font-medium text-sm text-slate-800">
              <span class="font-bold">${idx + 1}.</span> ${item.pertanyaan}
            </p>
        `;

        if (tipeSoal === "Pilihan Ganda" && item.opsi) {
          html += `<div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pl-4 text-sm text-slate-700">`;
          item.opsi.forEach(opt => {
            html += `<div>${opt}</div>`;
          });
          html += `</div>`;
        } else if (tipeSoal === "Isian Singkat") {
          html += `<div class="pl-4 pt-1"><div class="border-b border-dashed border-slate-400 w-full max-w-md h-6"></div></div>`;
        } else {
          html += `
            <div class="pl-4 pt-1 space-y-2">
              <div class="border-b border-dashed border-slate-300 w-full h-5"></div>
              <div class="border-b border-dashed border-slate-300 w-full h-5"></div>
            </div>
          `;
        }

        html += `</div>`;
      });

      html += `</div>`;

      // KUNCI JAWABAN
      html += `
        <div class="mt-10 pt-6 border-t-2 border-dashed border-slate-300">
          <h3 class="font-bold text-sm text-slate-700 uppercase tracking-wider mb-3">Kunci Jawaban & Pembahasan</h3>
          <div class="space-y-2 text-xs text-slate-600">
      `;

      daftarSoal.forEach((item, idx) => {
        html += `<p><strong>${idx + 1}. Jawaban: ${item.jawaban || '-'}</strong> — ${item.pembahasan || ''}</p>`;
      });

      html += `</div></div>`;

      output.innerHTML = html;
      container.classList.remove("hidden");
      container.scrollIntoView({ behavior: "smooth" });
    }

    // RENDER FALLBACK UNTUK SIMULASI LOKAL
    function renderQuizFallback(jenjang, kelas, mapel, topik, tipeSoal, jumlah, level) {
      const container = document.getElementById("resultContainer");
      const output = document.getElementById("quizOutput");

      let html = `
        <div class="border-b-2 border-slate-800 pb-4 mb-6 text-center">
          <h2 class="text-xl font-bold uppercase tracking-wide">LEMBAR UJIAN / ASSESMEN</h2>
          <p class="text-sm font-semibold text-slate-600">${mapel} — ${jenjang} (${kelas})</p>
          <p class="text-xs text-slate-500 italic mt-0.5">Materi / Topik: ${topik}</p>
        </div>

        <div class="grid grid-cols-2 text-xs font-semibold gap-2 border p-3 rounded-lg bg-slate-50 mb-6">
          <div>Nama Siswa : ...........................................</div>
          <div>Tanggal : .........................</div>
          <div>Kelas/No : ...........................................</div>
          <div>Waktu : 45 Menit</div>
        </div>

        <div class="space-y-6">
      `;

      for (let i = 1; i <= jumlah; i++) {
        html += `
          <div class="space-y-2">
            <p class="font-medium text-sm text-slate-800">
              <span class="font-bold">${i}.</span> Berikut adalah pertanyaan ke-${i} mengenai materi <span class="font-semibold text-indigo-600">${topik}</span> pada pelajaran ${mapel} (${jenjang} ${kelas})?
            </p>
        `;

        if (tipeSoal === "Pilihan Ganda") {
          html += `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pl-4 text-sm text-slate-700">
              <div>A. Opsi Pilihan A</div>
              <div>B. Opsi Pilihan B</div>
              <div>C. Opsi Pilihan C</div>
              <div>D. Opsi Pilihan D</div>
            </div>
          `;
        } else if (tipeSoal === "Isian Singkat") {
          html += `<div class="pl-4 pt-1"><div class="border-b border-dashed border-slate-400 w-full max-w-md h-6"></div></div>`;
        } else {
          html += `
            <div class="pl-4 pt-1 space-y-2">
              <div class="border-b border-dashed border-slate-300 w-full h-5"></div>
              <div class="border-b border-dashed border-slate-300 w-full h-5"></div>
            </div>
          `;
        }

        html += `</div>`;
      }

      html += `</div>`;

      html += `
        <div class="mt-10 pt-6 border-t-2 border-dashed border-slate-300">
          <h3 class="font-bold text-sm text-slate-700 uppercase tracking-wider mb-2">Kunci Jawaban & Ringkasan</h3>
          <p class="text-xs text-slate-500">Tipe: ${tipeSoal} | Level Kesulitan: ${level}</p>
        </div>
      `;

      output.innerHTML = html;
      container.classList.remove("hidden");
      container.scrollIntoView({ behavior: "smooth" });
    }
  </script>
