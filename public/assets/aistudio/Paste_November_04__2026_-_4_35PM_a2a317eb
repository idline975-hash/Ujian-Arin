<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pembuat Soal Otomatis</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body {
      font-family: 'Inter', sans-serif;
    }
    @media print {
      .no-print { display: none !important; }
      .print-only { display: block !important; }
      body { background: white; padding: 0; }
      .card-shadow { box-shadow: none !important; border: none !important; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen py-8 px-4 sm:px-6">

  <div class="max-w-2xl mx-auto space-y-6">
    
    <!-- CARD UTAMA -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden no-print border border-slate-100">
      
      <!-- HEADER -->
      <div class="bg-gradient-to-r from-indigo-600 via-indigo-500 to-indigo-600 px-6 py-6 text-center text-white relative">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Pembuat Soal Otomatis</h1>
        <p class="text-indigo-100 text-xs sm:text-sm mt-1">Generator Ujian & Kunci Jawaban Instan Berbasis AI (Sekolah & Madrasah)</p>
      </div>

      <!-- FORM BODY -->
      <form id="quizForm" onsubmit="generateQuiz(event)" class="p-6 sm:p-8 space-y-5">
        
        <!-- BARIS 1: Jenjang, Kelas, Mata Pelajaran -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          
          <!-- Jenjang Pendidikan -->
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
              Jenjang Pendidikan <span class="text-red-500">*</span>
            </label>
            <select id="jenjang" onchange="handleJenjangChange()" required
              class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
              <option value="SD / MI">SD / MI</option>
              <option value="SMP / MTs" selected>SMP / MTs</option>
              <option value="SMA / MA / SMK">SMA / MA / SMK</option>
            </select>
          </div>

          <!-- Kelas -->
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
              Kelas <span class="text-red-500">*</span>
            </label>
            <select id="kelas" required
              class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
              <!-- Diisi otomatis oleh JS -->
            </select>
          </div>

          <!-- Mata Pelajaran -->
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
              Mata Pelajaran <span class="text-red-500">*</span>
            </label>
            <select id="mapel" onchange="handleMapelChange()" required
              class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
              <!-- Diisi otomatis oleh JS -->
            </select>
          </div>

        </div>

        <!-- BARIS 2: Topik / Materi Spesifik -->
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">
            Topik / Materi Spesifik <span class="text-red-500">*</span>
          </label>
          <select id="topikSelect" onchange="handleTopikChange()" required
            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
            <!-- Diisi otomatis oleh JS -->
          </select>
          
          <!-- Input Manual jika memilih "Lainnya" -->
          <input type="text" id="topikManual" placeholder="Tuliskan topik spesifik..." 
            class="hidden mt-2 w-full bg-white border border-indigo-300 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>

        <!-- BARIS 3: Tipe Soal & Jumlah Soal -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Tipe Soal</label>
            <select id="tipeSoal"
              class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="Pilihan Ganda" selected>Pilihan Ganda (A, B, C, D)</option>
              <option value="Isian Singkat">Isian Singkat</option>
              <option value="Uraian / Essay">Uraian / Essay</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Jumlah Soal</label>
            <input type="number" id="jumlahSoal" min="1" max="25" value="5" required
              class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>

        </div>

        <!-- PARAMETER KESULITAN -->
        <div class="bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 space-y-3">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Parameter Kesulitan</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <select id="levelKesulitan"
              class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="Level 1: Mudah (Pemahaman & Mengingat)">Level 1: Mudah (C1 - C2)</option>
              <option value="Level 2: Sedang (Aplikasi & Analisis)" selected>Level 2: Sedang (C3 - C4)</option>
              <option value="Level 3: Sulit / HOTS (Evaluasi & Kreasi)">Level 3: Sulit / HOTS (C5 - C6)</option>
            </select>

            <select id="distribusiSoal"
              class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="Proporsional (Normal)" selected>Proporsional (Normal)</option>
              <option value="Fokus HOTS (70% Sulit)">Fokus HOTS (70% Sulit)</option>
              <option value="Seragam (Tingkat Kesulitan Sama)">Seragam (Tingkat Kesulitan Sama)</option>
            </select>
          </div>
        </div>

        <!-- TOMBOL SUBMIT -->
        <button type="submit" id="btnSubmit"
          class="w-full bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white font-semibold py-3.5 px-4 rounded-xl shadow-lg shadow-indigo-500/25 transition duration-200 flex items-center justify-center gap-2 active:scale-[0.99]">
          <i data-lucide="rocket" class="w-5 h-5"></i>
          <span>Buat Soal</span>
        </button>

      </form>
    </div>

    <!-- HASIL GENERASI SOAL -->
    <div id="resultContainer" class="hidden bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-slate-100">
      <div class="flex justify-between items-center border-b pb-4 mb-6 no-print">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
          <i data-lucide="file-check" class="text-indigo-600"></i> Hasil Lembar Soal
        </h2>
        <div class="flex gap-2">
          <button onclick="window.print()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold flex items-center gap-1.5 transition">
            <i data-lucide="printer" class="w-4 h-4"></i> Cetak / PDF
          </button>
        </div>
      </div>

      <!-- KONTEN LEMBAR SOAL -->
      <div id="quizOutput" class="space-y-6 text-slate-800">
        <!-- Hasil soal akan di-render di sini -->
      </div>
    </div>

  </div>

  <script>
    // DATA DYNAMIC CASCADING SELECTS TERMASUK PELAJARAN KEAGAMAAN MADRASAH (MI, MTs, MA)
    const dataPendidikan = {
      "SD / MI": {
        kelas: ["Kelas 1", "Kelas 2", "Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6"],
        mapel: {
