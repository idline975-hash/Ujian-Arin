                kelas: ["Kelas 10", "Kelas 11", "Kelas 12"],
                mapel: ["Matematika Wajib", "Matematika Tingkat Lanjut", "Fisika", "Kimia", "Biologi", "Ekonomi", "Sejarah", "Sosiologi", "Bahasa Indonesia", "Bahasa Inggris"],
                topik: {
                    "Matematika Wajib": [
                        "Persamaan & Pertidaksamaan Nilai Mutlak",
