<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembuat Soal Otomatis</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Inter & Font Awesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- MathJax for rendering math formulas if needed -->
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f3f8;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #c7d2fe;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #818cf8;
        }
        /* Style for Print/PDF output */
        @media print {
            body {
                background-color: #ffffff !important;
            }
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            .shadow-xl, .shadow-md, .shadow-sm {
                box-shadow: none !important;
            }
            .border {
                border: 1px solid #e5e7eb !important;
            }
        }
    </style>
</head>
<body class="min-h-screen py-8 px-4 sm:px-6 flex flex-col justify-center items-center">

    <!-- Container Utama -->
    <div class="w-full max-w-2xl bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100 transition-all duration-300">
        
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-500 py-6 px-6 text-center text-white relative overflow-hidden">
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
            <div class="absolute -left-6 -top-6 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Pembuat Soal Otomatis</h1>
            <p class="text-indigo-100 text-xs sm:text-sm mt-1">Buat lembar soal ujian & kunci jawaban instan berbasis kurikulum</p>
        </div>

        <!-- Form Pembuat Soal -->
        <form id="quizForm" onsubmit="generateQuestions(event)" class="p-6 sm:p-8 space-y-5 no-print">
            
            <!-- Baris 1: Jenjang, Kelas, Mata Pelajaran -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Jenjang Pendidikan -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Jenjang Pendidikan *</label>
                    <div class="relative">
                        <select id="jenjang" onchange="onJenjangChange()" required class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                            <option value="SD / MI">SD / MI</option>
                            <option value="SMP / MTs" selected>SMP / MTs</option>
                            <option value="SMA / MA">SMA / MA</option>
                            <option value="SMK">SMK</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Kelas (Dropdown Dinamis) -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Kelas *</label>
                    <div class="relative">
                        <select id="kelas" onchange="onKelasOrMapelChange()" required class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                            <!-- Populated by JS -->
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Mata Pelajaran (Dropdown Dinamis) -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Mata Pelajaran *</label>
                    <div class="relative">
                        <select id="mapel" onchange="onKelasOrMapelChange()" required class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                            <!-- Populated by JS -->
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Baris 2: Topik / Materi Spesifik (Dropdown Dinamis) -->
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5">Topik / Materi Spesifik *</label>
                <div class="relative">
                    <select id="topikSelect" onchange="onTopikSelectChange()" required class="w-full px-3.5 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                        <!-- Populated by JS -->
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </div>
                </div>
                <!-- Input Manual Tambahan Jika Pilih 'Lainnya / Input Manual' -->
                <input type="text" id="topikManual" placeholder="Tuliskan topik / materi spesifik secara manual..."
                    class="hidden mt-2.5 w-full px-3.5 py-2.5 bg-white border border-indigo-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-gray-400">
            </div>

            <!-- Baris 3: Tipe Soal & Jumlah Soal -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Tipe Soal -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Tipe Soal</label>
                    <div class="relative">
                        <select id="tipeSoal" class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                            <option value="Pilihan Ganda">Pilihan Ganda</option>
                            <option value="Isian Singkat">Isian Singkat</option>
                            <option value="Uraian / Essay">Uraian / Essay</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Jumlah Soal -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1.5">Jumlah Soal</label>
                    <input type="number" id="jumlahSoal" min="1" max="20" value="5" required
                        class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
            </div>

            <!-- Kotak Parameter Kesulitan -->
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3">
                <span class="block text-xs font-bold text-gray-500 tracking-wider uppercase">PARAMETER KESULITAN</span>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- Level Kesulitan -->
                    <div class="relative">
                        <select id="levelKesulitan" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-xs sm:text-sm text-gray-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                            <option value="Level 1: Mudah (Mengingat/C1-C2)">Level 1: Mudah (Mengingat)</option>
                            <option value="Level 2: Sedang (Aplikasi/C3)" selected>Level 2: Sedang (Aplikasi)</option>
                            <option value="Level 3: Sukar (HOTS/C4-C6)">Level 3: Sukar (HOTS)</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>

                    <!-- Distribusi -->
                    <div class="relative">
                        <select id="distribusi" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-xs sm:text-sm text-gray-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none appearance-none transition-all cursor-pointer">
                            <option value="Proporsional (Normal)" selected>Proporsional (Normal)</option>
                            <option value="Fokus HOTS">Fokus HOTS</option>
                            <option value="Seimbang">Seimbang</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-500">
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tombol Eksekusi -->
            <div class="pt-2">
                <button type="submit" id="btnSubmit" 
                    class="w-full bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white font-medium py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 group">
                    <span class="text-base group-hover:scale-110 transition-transform">🚀</span>
                    <span>Buat Soal</span>
                </button>
            </div>
        </form>

        <!-- Loading State -->
        <div id="loadingState" class="hidden py-12 px-6 text-center space-y-4 no-print">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-indigo-200 border-t-indigo-600"></div>
            <div class="space-y-1">
                <p class="text-indigo-900 font-semibold text-base">Sedang Menyusun Soal...</p>
                <p class="text-gray-500 text-xs">Menyusun pertanyaan, opsi jawaban, dan pembahasan rinci.</p>
            </div>
        </div>

    </div>

    <!-- Output Hasil Soal (Menampil di bawah Form) -->
    <div id="outputSection" class="w-full max-w-4xl mt-8 hidden transition-all duration-500">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
            
            <!-- Output Control Header -->
            <div class="bg-slate-800 text-white p-4 sm:p-5 flex flex-wrap justify-between items-center gap-3 no-print">
                <div class="flex items-center gap-2">
                    <span class="bg-indigo-500 text-white text-xs px-2.5 py-1 rounded-md font-semibold" id="outBadge">Soal Siap</span>
                    <h2 class="text-sm sm:text-base font-medium text-slate-200" id="outTitleInfo">Hasil Generasi Soal</h2>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Toggle Answer Key -->
                    <button onclick="toggleAnswers()" id="btnToggleAnswers" 
                        class="bg-slate-700 hover:bg-slate-600 text-xs text-white px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5">
                        <i class="fa-solid fa-eye text-indigo-400"></i>
                        <span id="toggleText">Tampilkan Kunci Jawaban</span>
                    </button>
                    <!-- Copy to Clipboard -->
                    <button onclick="copyQuestionsText()" 
                        class="bg-slate-700 hover:bg-slate-600 text-xs text-white px-3 py-2 rounded-lg transition-colors flex items-center gap-1.5">
                        <i class="fa-regular fa-copy text-teal-400"></i>
                        <span>Salin Teks</span>
                    </button>
                    <!-- Print / PDF -->
                    <button onclick="window.print()" 
                        class="bg-indigo-600 hover:bg-indigo-700 text-xs text-white px-3.5 py-2 rounded-lg font-medium transition-colors flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-print"></i>
                        <span>Cetak / PDF</span>
                    </button>
                </div>
            </div>

            <!-- Lembar Cetak / Konten Soal -->
            <div id="printableArea" class="p-6 sm:p-10 space-y-6 bg-white">
                
                <!-- KOP Dokumen Soal -->
                <div class="border-b-2 border-slate-800 pb-4 text-center space-y-1">
                    <h2 class="text-xl font-bold uppercase tracking-wide text-slate-900" id="docMapelHeader">ULANGAN HARIAN MATEMATIKA</h2>
                    <p class="text-xs sm:text-sm text-gray-600 font-medium">
                        <span id="docJenjangHeader">SMP / MTs</span> &bull; <span id="docKelasHeader">Kelas 8</span> | Topik: <span id="docTopikHeader" class="italic">Teorema Pythagoras</span>
                    </p>
                    <div class="flex justify-between items-center text-xs text-gray-500 pt-2 px-2">
                        <span>Waktu: 45 Menit</span>
                        <span>Sifat: Tertutup</span>
                        <span>Tipe: <span id="docTipeHeader">Pilihan Ganda</span></span>
                    </div>
                </div>

                <!-- Identitas Siswa (Hanya untuk Cetak) -->
                <div class="grid grid-cols-2 gap-4 text-xs sm:text-sm pb-2 border-b border-dashed border-gray-300">
                    <div>
                        <p><span class="font-semibold">Nama Siswa :</span> ...........................................................</p>
                        <p class="mt-1"><span class="font-semibold">Nomor Absen:</span> ...........................................................</p>
                    </div>
                    <div class="text-right">
                        <p><span class="font-semibold">Hari/Tanggal :</span> ...........................................................</p>
                        <p class="mt-1"><span class="font-semibold">Nilai        :</span> ....................</p>
                    </div>
                </div>

                <!-- Daftar Soal -->
                <div id="questionList" class="space-y-6 pt-2">
                    <!-- Dynamic Question Content Will Be Injected Here -->
                </div>

                <!-- Kunci Jawaban & Pembahasan Section -->
                <div id="answerKeySection" class="hidden mt-10 pt-6 border-t-2 border-indigo-200 bg-indigo-50/40 p-4 sm:p-6 rounded-xl">
                    <div class="flex items-center gap-2 mb-4">
                        <i class="fa-solid fa-key text-indigo-600"></i>
                        <h3 class="font-bold text-base text-indigo-900">Kunci Jawaban & Pembahasan Detil</h3>
                    </div>
                    <div id="answerList" class="space-y-4 text-xs sm:text-sm text-slate-800">
                        <!-- Dynamic Answers Injected Here -->
                    </div>
                </div>
            </div>

            <!-- Toast Notification -->
            <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white text-xs px-4 py-3 rounded-lg shadow-2xl hidden items-center gap-2 z-50 transition-all">
                <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
                <span id="toastMsg">Berhasil disalin ke clipboard!</span>
            </div>

        </div>
    </div>

    <!-- Script Logika & AI Integration -->
    <script>
        // Database Opsi Dinamis Berdasarkan Jenjang & Mata Pelajaran
        const dataMaster = {
