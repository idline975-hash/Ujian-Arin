        // Populate Opsi Dropdown Dinamis
        function populateOptions() {
            const jenjangVal = document.getElementById('jenjang').value;
            const kelasSelect = document.getElementById('kelas');
            const mapelSelect = document.getElementById('mapel');
            
            const jenjangData = dataMaster[jenjangVal] || dataMaster["SMP / MTs"];

            // Populasikan Kelas
            kelasSelect.innerHTML = '';
            jenjangData.kelas.forEach((k, idx) => {
                const opt = document.createElement('option');
                opt.value = k;
                opt.textContent = k;
                if (jenjangVal === "SMP / MTs" && idx === 1) opt.selected = true; // Default Kelas 8
                kelasSelect.appendChild(opt);
            });

            // Populasikan Mata Pelajaran
            mapelSelect.innerHTML = '';
            jenjangData.mapel.forEach((m, idx) => {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = m;
                if (idx === 0) opt.selected = true;
                mapelSelect.appendChild(opt);
            });

            // Populate Topik
            populateTopik();
        }

        // Populate Dropdown Topik Berdasarkan Mapel
        function populateTopik() {
            const jenjangVal = document.getElementById('jenjang').value;
            const mapelVal = document.getElementById('mapel').value;
            const topikSelect = document.getElementById('topikSelect');

            const mapelTopiks = (dataMaster[jenjangVal]?.topik?.[mapelVal]) || [
                "Konsep Dasar dan Teori Utama",
                "Analisis Kasus & Penerapan Praktis",
                "Evaluasi dan Penyelesaian Masalah"
            ];

            topikSelect.innerHTML = '';
            mapelTopiks.forEach((t) => {
                const opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                topikSelect.appendChild(opt);
            });

            // Opsi Tambahan Input Manual
            const customOpt = document.createElement('option');
            customOpt.value = "LAINNYA";
            customOpt.textContent = "✏️ Lainnya / Input Manual...";
            topikSelect.appendChild(customOpt);

            onTopikSelectChange();
        }

        // Handler saat Jenjang berubah
        function onJenjangChange() {
            populateOptions();
        }

        // Handler saat Kelas atau Mapel berubah
        function onKelasOrMapelChange() {
            populateTopik();
        }

        // Handler saat Topik Select berubah (menampilkan input manual jika memilih 'Lainnya')
        function onTopikSelectChange() {
            const topikSelect = document.getElementById('topikSelect');
            const topikManual = document.getElementById('topikManual');

            if (topikSelect.value === "LAINNYA") {
                topikManual.classList.remove('hidden');
                topikManual.setAttribute('required', 'true');
            } else {
                topikManual.classList.add('hidden');
                topikManual.removeAttribute('required');
                topikManual.value = '';
            }
        }

        // Inisialisasi awal saat dokumen siap
        document.addEventListener('DOMContentLoaded', () => {
            populateOptions();
        });

        let isAnswersVisible = false;
        let generatedData = null;

        // Toggle Tampilan Kunci Jawaban
        function toggleAnswers() {
            const answerSection = document.getElementById('answerKeySection');
            const toggleText = document.getElementById('toggleText');
            const icon = document.getElementById('btnToggleAnswers').querySelector('i');

            isAnswersVisible = !isAnswersVisible;

            if (isAnswersVisible) {
                answerSection.classList.remove('hidden');
                toggleText.innerText = "Sembunyikan Kunci Jawaban";
                icon.className = "fa-solid fa-eye-slash text-indigo-400";
            } else {
                answerSection.classList.add('hidden');
                toggleText.innerText = "Tampilkan Kunci Jawaban";
                icon.className = "fa-solid fa-eye text-indigo-400";
            }
        }

        // Tampilkan Toast Message
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            toastMsg.innerText = message;
            toast.classList.remove('hidden');
            toast.classList.add('flex');
            setTimeout(() => {
                toast.classList.add('hidden');
                toast.classList.remove('flex');
            }, 3000);
        }

        // Copy Text Soal ke Clipboard
        function copyQuestionsText() {
            if (!generatedData) return;

            let text = `SOAL ${generatedData.mapel.toUpperCase()}\n`;
            text += `Jenjang: ${generatedData.jenjang} (${generatedData.kelas})\n`;
            text += `Materi: ${generatedData.topik}\n\n`;
            text += `--------------------------------------------------\n\n`;

            generatedData.soal.forEach((item, index) => {
                text += `${index + 1}. ${item.pertanyaan}\n`;
                if (item.opsi && item.opsi.length > 0) {
                    item.opsi.forEach(opt => {
                        text += `   ${opt}\n`;
                    });
                }
                text += `\n`;
            });

            if (isAnswersVisible) {
                text += `\n==================================================\n`;
                text += `KUNCI JAWABAN & PEMBAHASAN\n`;
                text += `==================================================\n\n`;
                generatedData.soal.forEach((item, index) => {
                    text += `${index + 1}. Kunci: ${item.kunci}\n`;
                    text += `   Pembahasan: ${item.pembahasan}\n\n`;
                });
            }

            // Standard Copy Fallback
            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            showToast("Teks Soal berhasil disalin ke clipboard!");
        }

        // Main Handler Generator Soal
        async function generateQuestions(e) {
            e.preventDefault();

            // Ambil Input Form
            const jenjang = document.getElementById('jenjang').value;
            const kelas = document.getElementById('kelas').value;
            const mapel = document.getElementById('mapel').value;
            
            // Ambil nilai topik dari select atau input manual
            const topikSelectVal = document.getElementById('topikSelect').value;
            const topikManualVal = document.getElementById('topikManual').value;
            const topik = (topikSelectVal === "LAINNYA") ? topikManualVal : topikSelectVal;

            const tipeSoal = document.getElementById('tipeSoal').value;
            const jumlahSoal = Math.min(20, Math.max(1, parseInt(document.getElementById('jumlahSoal').value) || 5));
            const levelKesulitan = document.getElementById('levelKesulitan').value;
            const distribusi = document.getElementById('distribusi').value;

            // Update UI State Loading
            document.getElementById('loadingState').classList.remove('hidden');
            document.getElementById('outputSection').classList.add('hidden');
            
            // Scroll ke loading
            document.getElementById('loadingState').scrollIntoView({ behavior: 'smooth' });

            const promptText = `Buatkan ${jumlahSoal} soal berkualitas untuk materi '${topik}' mata pelajaran '${mapel}' tingkat ${jenjang} (${kelas}).
Tipe soal: ${tipeSoal}.
Tingkat Kesulitan: ${levelKesulitan}.
Distribusi: ${distribusi}.

Berikan output HANYA berupa JSON valid tanpa format markdown (tanpa \`\`\`json) dengan struktur seperti ini:
{
  "soal": [
    {
      "id": 1,
      "pertanyaan": "Isi pertanyaan disini?",
      "opsi": ["A. pilihan 1", "B. pilihan 2", "C. pilihan 3", "D. pilihan 4"], 
      "kunci": "A. pilihan 1",
      "pembahasan": "Penjelasan rinci langkah demi langkah penyelesaiannya."
    }
  ]
}
Catatan: Jika Tipe soal 'Isian Singkat' atau 'Uraian / Essay', array 'opsi' boleh disesuaikan atau dikosongkan ([]).`;

            try {
                let dataResult = null;
                const apiKey = ""; // Disertakan secara otomatis oleh sistem lingkungan runtime
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{ parts: [{ text: promptText }] }],
                    generationConfig: {
                        responseMimeType: "application/json"
                    }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const resJson = await response.json();
                    const jsonString = resJson.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (jsonString) {
                        dataResult = JSON.parse(jsonString);
                    }
                }
                
                // Fallback Generator jika API tidak tersedia atau gagal
                if (!dataResult || !dataResult.soal) {
                    dataResult = generateMockData(mapel, topik, jenjang, kelas, tipeSoal, jumlahSoal);
                }

                // Simpan State Hasil
                generatedData = {
                    jenjang, kelas, mapel, topik, tipeSoal,
                    soal: dataResult.soal
                };

                // Render ke UI
                renderQuestions(generatedData);

            } catch (err) {
                console.error("Error generating question:", err);
                // Render fallback lokal jika terjadi error jaringan
                generatedData = {
                    jenjang, kelas, mapel, topik, tipeSoal,
                    soal: generateMockData(mapel, topik, jenjang, kelas, tipeSoal, jumlahSoal).soal
                };
                renderQuestions(generatedData);
            } finally {
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('outputSection').classList.remove('hidden');
                document.getElementById('outputSection').scrollIntoView({ behavior: 'smooth' });
            }
        }

        // Render Konten Soal ke HTML
        function renderQuestions(data) {
            // Render Header Dokumen
            document.getElementById('docMapelHeader').innerText = `SOAL ULANGAN ${data.mapel.toUpperCase()}`;
            document.getElementById('docJenjangHeader').innerText = data.jenjang;
            document.getElementById('docKelasHeader').innerText = data.kelas;
            document.getElementById('docTopikHeader').innerText = data.topik;
            document.getElementById('docTipeHeader').innerText = data.tipeSoal;

            const questionList = document.getElementById('questionList');
            const answerList = document.getElementById('answerList');

            questionList.innerHTML = '';
            answerList.innerHTML = '';

            data.soal.forEach((item, index) => {
                // Item Soal UI
                const qDiv = document.createElement('div');
                qDiv.className = 'space-y-2 text-slate-800 text-sm sm:text-base leading-relaxed';
                
                let optionsHtml = '';
                if (item.opsi && item.opsi.length > 0) {
                    optionsHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2.5 pl-5">`;
                    item.opsi.forEach(opt => {
                        optionsHtml += `
                            <div class="flex items-start gap-2">
                                <span class="text-xs sm:text-sm font-medium text-slate-700">${opt}</span>
                            </div>
                        `;
                    });
                    optionsHtml += `</div>`;
                } else if (data.tipeSoal === 'Isian Singkat') {
                    optionsHtml = `<div class="mt-3 pl-5 text-gray-400 italic text-xs sm:text-sm">Jawaban: ............................................................................................</div>`;
                } else if (data.tipeSoal.includes('Essay') || data.tipeSoal.includes('Uraian')) {
                    optionsHtml = `
                        <div class="mt-3 pl-5 border-l-2 border-slate-200 space-y-4 py-2">
                            <div class="h-4 border-b border-dashed border-slate-300 w-full"></div>
                            <div class="h-4 border-b border-dashed border-slate-300 w-full"></div>
                            <div class="h-4 border-b border-dashed border-slate-300 w-full"></div>
                        </div>
                    `;
                }

                qDiv.innerHTML = `
                    <div class="flex items-start gap-2.5">
                        <span class="font-bold text-indigo-600 select-none">${index + 1}.</span>
                        <div class="flex-1 font-medium text-slate-900">${item.pertanyaan}</div>
                    </div>
                    ${optionsHtml}
                `;
                questionList.appendChild(qDiv);

                // Item Pembahasan UI
                const aDiv = document.createElement('div');
                aDiv.className = 'bg-white p-3.5 rounded-lg border border-indigo-100 shadow-sm space-y-1.5';
                aDiv.innerHTML = `
                    <div class="font-semibold text-slate-900">Soal No. ${index + 1}</div>
                    <div class="text-indigo-700 font-medium">Kunci Jawaban: <span class="bg-indigo-100 px-2 py-0.5 rounded text-indigo-900">${item.kunci}</span></div>
                    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mt-1"><span class="font-semibold text-slate-700">Pembahasan:</span> ${item.pembahasan}</p>
                `;
                answerList.appendChild(aDiv);
            });

            // Trigger MathJax re-render jika ada persamaan matematika
            if (window.MathJax) {
                MathJax.typesetPromise();
            }
        }

        // Function Mock Data Generator untuk Fallback Lokal
        function generateMockData(mapel, topik, jenjang, kelas, tipeSoal, jumlah) {
            const listSoal = [];
            
            for (let i = 1; i <= jumlah; i++) {
                if (topik.toLowerCase().includes('pythagoras') || mapel.toLowerCase().includes('matematika')) {
                    listSoal.push({
                        id: i,
                        pertanyaan: `Pada segitiga siku-siku ABC dengan sudut siku-siku di B, panjang sisi AB = ${3*i} cm dan BC = ${4*i} cm. Berapakah panjang hypotenusa AC?`,
                        opsi: [
                            `A. ${5*i} cm`,
                            `B. ${6*i} cm`,
                            `C. ${7*i} cm`,
                            `D. ${8*i} cm`
                        ],
                        kunci: `A. ${5*i} cm`,
                        pembahasan: `Menggunakan rumus Pythagoras: AC² = AB² + BC² = (${3*i})² + (${4*i})² = ${9*i*i} + ${16*i*i} = ${25*i*i}. Maka AC = √${25*i*i} = ${5*i} cm.`
                    });
                } else {
                    listSoal.push({
                        id: i,
                        pertanyaan: `Jelaskan prinsip utama dan penerapan dasar dari materi ${topik} dalam kehidupan sehari-hari (Pertanyaan Latihan No. ${i})?`,
                        opsi: tipeSoal === 'Pilihan Ganda' ? [
                            `A. Memudahkan identifikasi konsep dasar ${topik}`,
                            `B. Mengabaikan prinsip umum dari ${topik}`,
                            `C. Menghilangkan keterkaitan variabel materi`,
                            `D. Membatasi pengamatan pada satu objek`
                        ] : [],
                        kunci: `A. Memudahkan identifikasi konsep dasar ${topik}`,
                        pembahasan: `Materi ${topik} bertujuan untuk memberikan pemahaman komprehensif mengenai konsep dasar serta penerapannya secara efektif.`
                    });
                }
            }
            return { soal: listSoal };
        }
    </script>
